{
  "name": "oficina-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build && node scripts/check-dist.mjs",
    "start": "tsx server/index.ts",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@composio/core": "^0.17.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "^1.2.0",
    "fflate": "^0.8.3",
    "lucide": "^1.52.0",
    "simple-icons": "^16.34.0",
    "three": "^0.186.1",
    "unpdf": "^1.8.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
